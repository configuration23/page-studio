node_modules/
dist/
.env

# Состояние сессий, журнал и картинки — личные данные, в git не место.
data/state/
data/logs/
data/generations/*
!data/generations/.gitkeep

# Хеши API-токенов — секрет, не в git.
data/api-tokens.json

# Черновики живут до публикации и на диск публикации не попадают.
data/forms/*.draft.yaml

*.log
logs/
# Адреса целей — секрет конкретного стенда, в git только пример.
data/targets.yaml
# Настройки портала (страница по умолчанию) — тоже про конкретный стенд.
data/settings.yaml
# Состояния страниц — живые данные стенда.
data/page-state.json
