{
  "name": "page-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Конструктор личных страниц: блоки в YAML, данные из n8n, один контейнер",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --watch dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "demo": "node demo/driver.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
