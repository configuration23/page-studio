{
  "name": "page-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Конструктор личных страниц: элементы-методы, любой бэкенд по HTTP, один контейнер",
  "license": "MIT",
  "author": "configuration23",
  "homepage": "https://github.com/configuration23/page-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/configuration23/page-studio.git"
  },
  "bugs": {
    "url": "https://github.com/configuration23/page-studio/issues"
  },
  "keywords": [
    "page-builder",
    "form-designer",
    "self-hosted",
    "docker",
    "webhook",
    "rest",
    "low-code"
  ],
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --watch dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "demo": "node demo/driver.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
