# Пример nginx перед порталом.
# Два правила, без которых не работает:
#   1) proxy_read_timeout большой — генерация идёт десятки секунд;
#   2) proxy_buffering off для SSE, иначе события приходят пачками.

server {
    listen 80;
    server_name portal.local;

    # basic auth на весь портал: админ и пользователи — по одному паролю
    # htpasswd -c /etc/nginx/.htpasswd admin
    auth_basic "page-studio";
    auth_basic_user_file /etc/nginx/.htpasswd;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /api/v1/forms/ {
        # SSE: без буферизации и без сжатия
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 3600s;
    }
}
