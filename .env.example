# Порт и адрес. Наружу не публиковать: только nginx/VPN.
PORT=3000
HOST=127.0.0.1

# Токен для записи значений (n8n, драйвер). Обязателен, без него сервер не стартует.
PORTAL_TOKEN=change-me-long-random

# Вход в админку: HTTP Basic. Без ADMIN_PASSWORD админка выключена (503).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-long-random

DATA_DIR=data
FORMS_DIR=data/forms
LOGS_DIR=logs

# Предел размера картинки, байт.
MAX_IMAGE_BYTES=20971520
